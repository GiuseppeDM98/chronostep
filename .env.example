# Firebase Client SDK Configuration
# Obtain these values from Firebase Console > Project Settings > Your apps > Web app

# Step 1: Create a Firebase project at https://console.firebase.google.com/
# Step 2: Register a web app to get these credentials
# Step 3: Copy this file to .env and fill in your actual values
# Step 4: NEVER commit .env to version control (already in .gitignore)

# Your Firebase API key
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Your Firebase auth domain (usually: your-project-id.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Your Firebase project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Your Firebase app ID
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Optional: Disable new sign-ups unless the email is whitelisted.
# Set to "true" to block sign-ups, "false" or empty to allow all.
NEXT_PUBLIC_DISABLE_SIGNUPS=false

# Optional: Comma-separated list of allowed emails when sign-ups are disabled.
NEXT_PUBLIC_SIGNUP_WHITELIST=admin@example.com,team@example.com

# NOTE: FIREBASE_SERVICE_ACCOUNT is optional and not currently used in the codebase.
# The client-side Firebase SDK (above 4 variables) is sufficient for all functionality.

# ─── Cattura da note (Claude API) ────────────────────────────────────────────
# Used ONLY by the server route /api/ai/capture. Not NEXT_PUBLIC_: the key must never reach the
# browser. On Vercel, add it under Project Settings > Environment Variables.

# Your Anthropic API key. Without it the Cattura screen reports that the feature is not configured.
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Comma-separated list of the accounts allowed to spend that key.
# Leave it EMPTY and the route is open in development and closed in production — the demo account's
# credentials are printed on the sign-in screen, so "any signed-in user" would mean "anyone with
# the link", and every request costs real money.
AI_ALLOWED_EMAILS=you@example.com

# ─── Demo account (read-only) ────────────────────────────────────────────────
# The address whose credentials are printed on the sign-in screen. That account is READ-ONLY.
#
# It must name the same account as `isDemoAccount()` in firestore.rules, which is where read-only
# is actually enforced — this variable only lets the interface stop offering what the database will
# refuse. If the two drift, the app offers actions that then fail.
NEXT_PUBLIC_DEMO_EMAIL=admin@example.com
