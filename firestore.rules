rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsResource(resourceData) {
      return signedIn() && resourceData.userId == request.auth.uid;
    }

    function canAccess(resourceData) {
      return resourceData != null && ownsResource(resourceData);
    }

    match /tasks/{taskId} {
      allow read, create, update, delete: if (request.resource != null && canAccess(request.resource.data)) ||
        canAccess(resource.data);
    }

    match /steps/{stepId} {
      allow read, create, update, delete: if (request.resource != null && canAccess(request.resource.data)) ||
        canAccess(resource.data);
    }

    match /workLogs/{logId} {
      allow read, create, update, delete: if (request.resource != null && canAccess(request.resource.data)) ||
        canAccess(resource.data);
    }
  }
}
